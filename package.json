{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mcp-gadget/wiki-link-helper",
  "version": "0.1.0",
  "description": "a simple searching helper for wiki links",
  "main": "index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/cjs/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react.d.mts",
        "default": "./dist/esm/react.mjs"

      },
      "require": {
        "types": "./dist/cjs/react.d.ts",
        "default": "./dist/cjs/react.js"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/esm/next.d.mts",
        "default": "./dist/esm/next.mjs"
      },
      "require": {
        "types": "./dist/cjs/next.d.ts",
        "default": "./dist/cjs/next.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/esm/utils.d.mts",
        "default": "./dist/esm/utils.mjs"
      },
      "require": {
        "types": "./dist/cjs/utils.d.ts",
        "default": "./dist/cjs/utils.js"
      }
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint '**/*.{js,ts,tsx}' --fix",
    "prettier": "prettier --check **/*.{js,ts,tsx,json,yaml}",
    "prettier:fix": "prettier --write **/*.{js,ts,tsx,json,yaml}",
    "md": "markdownlint '**/*.md'",
    "md:fix": "markdownlint '**/*.md' --fix",
    "build": "pnpm run clean && vite build --config vite.config.mts && pnpm run build:dts",
    "build:dts": "tsup --config tsup.config.mts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ci",
    "devops"
  ],
  "author": "beak",
  "bugs": "https://github.com/friedScale/wiki-link-helper/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/friedScale/wiki-link-helper.git"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "beak",
      "email": "cowooco@gmail.com"
    }
  ],
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@naverpay/editorconfig": "^1.0.0",
    "@naverpay/eslint-config": "^2.3.1",
    "@naverpay/markdown-lint": "^1.0.0",
    "@naverpay/prettier-config": "^1.0.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "browserslist": "^4.26.2",
    "browserslist-to-esbuild": "^2.1.1",
    "core-js": "^3.45.1",
    "core-js-pure": "^3.45.1",
    "lefthook": "^1.13.4",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "rollup-preserve-directives": "^1.1.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "peerDependencies": {
    "next": "^13.0.0 || ^14.0.0 ",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
